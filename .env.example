# Copy to .env.local for development, and set the same keys in your host's
# environment for production.

# Absolute base for canonical URLs and OpenGraph/Twitter share images, read by
# `metadataBase` in src/app/layout.tsx. No trailing slash.
#   development: http://localhost:3005   (the port `pnpm dev` binds)
#   production:  https://kobisoccerschool.com   (matches the contact address —
#                confirm the live host before deploying)
NEXT_PUBLIC_SITE_URL=http://localhost:3005
